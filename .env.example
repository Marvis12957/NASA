# Copy to .env (gitignored). Leave empty here — paste values from Aura.
# Console: https://console.neo4j.io  → New instance (free) → Connect
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional LLM keys for GraphRAG extract + community summaries (never commit values).
# OPENAI_API_KEY=
# GROK_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-opus-5-5
ENABLE_TOOL_SEARCH=false
API_TIMEOUT_MS=3000000

# API protection (app.main). Empty API_KEY = no key required; set it before a public demo
# and send it as the X-API-Key header. Limits apply to /api/ask and /api/ask/stream.
API_KEY=
ASK_MAX_CHARS=2000
ASK_RATE_PER_MIN=20
ASK_MAX_CONCURRENT=4
# Comma-separated origins allowed by CORS. Empty = same-origin only (UI uses the Vite proxy).
CORS_ORIGINS=
# 1 = serve /docs and /openapi.json
ENABLE_DOCS=0
# Batch scripts wait for an LLM quota reset on HTTP 429; the API never does.
LLM_WAIT_FOR_QUOTA=1

# Figure CDN. The API only needs the cloud name: /api/media/<path under data/>
# redirects there when the file is not on disk. Key and secret are used only by
# backend/scripts/upload_cloudinary.py. Never commit the secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clerk Auth (optional — auth stays OFF while these are empty; the app and
# the public demo remain fully usable without any login). See docs/AUTH_CLERK.md.
# The frontend also needs the publishable key at build time
# (frontend/.env → VITE_CLERK_PUBLISHABLE_KEY=pk_...).
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_SECRET_KEY=
